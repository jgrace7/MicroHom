Bootstrap: docker
From: ubuntu:22.04

%labels
    Maintainer MicroHom
    Description Portable Singularity image for MOOSE (combined app: solid_mechanics + heat_transfer + all other modules)

%environment
    export PATH=/opt/miniforge3/bin:$PATH
    export PATH=/opt/miniforge3/envs/moose/bin:$PATH
    export MOOSE_DIR=/opt/projects/moose
    export PATH=/opt/projects/moose/modules/combined:$PATH

%post
    export DEBIAN_FRONTEND=noninteractive

    # Install prerequisites
    apt-get update && apt-get install -y --no-install-recommends \
        wget curl git ca-certificates build-essential file \
        && rm -rf /var/lib/apt/lists/*

    # Install Miniforge
    wget -q https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh -O /tmp/miniforge.sh
    bash /tmp/miniforge.sh -b -p /opt/miniforge3
    rm /tmp/miniforge.sh

    export PATH=/opt/miniforge3/bin:$PATH

    # Configure Conda and create the pinned environment
    conda config --add channels https://conda.software.inl.gov/public
    conda config --add channels conda-forge
    conda create -y -n moose moose-dev=2026.10.19=mpich

    # Force bash for the activation, clone, and build steps
    /bin/bash -c "
        source /opt/miniforge3/etc/profile.d/conda.sh
        conda activate moose

        mkdir -p /opt/projects
        cd /opt/projects

        # Clone MOOSE
        git clone https://github.com/idaholab/moose.git
        cd moose

        # Keep this commit identical to the MOOSE checkout you use for local builds
        git checkout 96fe103c58957faac4764165f8a5b7d9f86829f5

        git submodule update --init --recursive

        # Compile the combined app (all modules, including solid_mechanics and heat_transfer).
        # The combined build is memory-hungry; raise -j only if the build machine has plenty of RAM.
        cd modules/combined
        make -j 4
    "

    conda clean -a -y
    chmod -R 777 /opt/projects/moose

%test
    # Fails the image build if the executable was not produced
    test -x /opt/projects/moose/modules/combined/combined-opt

%runscript
    /bin/bash -c "source /opt/miniforge3/etc/profile.d/conda.sh && conda activate moose && exec /opt/projects/moose/modules/combined/combined-opt \"\$@\""
