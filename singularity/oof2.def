Bootstrap: docker
From: ubuntu:24.04

%post
    # Prevent interactive prompts during apt-get
    export DEBIAN_FRONTEND=noninteractive
    
    # 1. Install system dependencies (including BLAS, LAPACK, Matplotlib)
    apt-get update
    apt-get install -y build-essential cmake swig pkg-config git \
                       python3 python3-dev python3-numpy python3-skimage python3-pil python3-matplotlib \
                       libblas-dev liblapack-dev \
                       libcairo2-dev libpango1.0-dev libglib2.0-dev libgtk-3-dev \
                       libcairomm-1.0-dev libpangomm-1.4-dev libgtkmm-3.0-dev \
                       python3-gi python3-gi-cairo python-gi-dev libgirepository1.0-dev
    
    PREFIX=/opt/oof2
    
    # 2. Clean up any leftover build directories
    rm -rf /tmp/oofcanvas /tmp/OOF2

    # 3. Clone and build OOFCanvas
    cd /tmp
    git clone https://github.com/usnistgov/oofcanvas.git
    cd oofcanvas
    mkdir build && cd build
    cmake .. -DCMAKE_INSTALL_PREFIX=$PREFIX \
             -DPython_EXECUTABLE=/usr/bin/python3 \
             -DPython3_EXECUTABLE=/usr/bin/python3
    make -j $(nproc)
    make install

    # 4. Export PKG_CONFIG_PATH so OOF2 finds oofcanvas
    export PKG_CONFIG_PATH=$PREFIX/lib/pkgconfig:$PREFIX/lib64/pkgconfig:$PKG_CONFIG_PATH

    # 5. Clone and build OOF2
    cd /tmp
    git clone https://github.com/usnistgov/OOF2.git
    cd OOF2
    mkdir build && cd build
    cmake .. -DCMAKE_INSTALL_PREFIX=$PREFIX \
             -DPython_EXECUTABLE=/usr/bin/python3 \
             -DPython3_EXECUTABLE=/usr/bin/python3
    make -j $(nproc)
    make install

    # 6. Clean up temporary source files
    rm -rf /tmp/oofcanvas /tmp/OOF2

%environment
    # Expose self-contained OOF2 binaries and Python packages inside the image
    export PATH=/opt/oof2/bin:$PATH
    export PYTHONPATH=/opt/oof2/lib/python3.12/dist-packages:/opt/oof2/lib/python3.12/site-packages:$PYTHONPATH